-- ================= HELPERS =================
local function getCharacter()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    return char, root, hum
end

local function getKickTarget()
    local areas = workspace:FindFirstChild("Areas")
    local target = areas and areas:FindFirstChild("KickReady")
    if not target then return nil end
    if target:IsA("BasePart") then return target.CFrame end
    if target:IsA("Model") then return target:GetPivot() end
    return nil
end

local function forceTP(root, targetCF)
    if not root or not root.Parent then return false end
    local ok = pcall(function()
        root.CFrame = targetCF
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    return ok
end

-- ================= KICK (cứng) =================
local function findKickButton()
    local hud = PlayerGui:FindFirstChild("HUD")
    if hud then
        local btn = hud:FindFirstChild("KickButton", true)
        if btn and btn:IsA("GuiButton") and btn.Visible then
            return btn
        end
    end

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj.Name == "KickButton" and obj:IsA("GuiButton") and obj.Visible then
            return obj
        end
    end

    local keywords = {"cú đá", "kick", "đá", "kickbutton", "đá bóng"}
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("GuiButton") and obj.Visible then
            local text = ""
            pcall(function()
                text = string.lower((obj.Text or "") .. " ")
                local label = obj:FindFirstChildOfClass("TextLabel")
                if label then text = text .. string.lower(label.Text or "") end
            end)
            for _, kw in ipairs(keywords) do
                if string.find(text, kw) then return obj end
            end
        end
    end
    return nil
end

local function fireKickButton(button)
    if not button or not button:IsA("GuiButton") then return false end
    local fired = false

    if getconnections then
        for _, sig in ipairs({"MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up"}) do
            local ok, conns = pcall(function() return getconnections(button[sig]) end)
            if ok and conns then
                for _, c in ipairs(conns) do
                    pcall(function() c:Fire() fired = true end)
                end
            end
        end
    end

    if firesignal then
        pcall(function() firesignal(button.Activated) fired = true end)
        pcall(function() firesignal(button.MouseButton1Click) fired = true end)
    end

    local absPos = button.AbsolutePosition
    local absSize = button.AbsoluteSize
    if absSize.X > 5 and absSize.Y > 5 then
        local bx = math.floor(absPos.X + absSize.X / 2)
        local by = math.floor(absPos.Y + absSize.Y / 2)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(bx, by, 0, true, game, 1)
            task.wait(0.04)
            VirtualInputManager:SendMouseButtonEvent(bx, by, 0, false, game, 1)
            fired = true
        end)
    end

    if KickRemote and KickRemote:IsA("RemoteEvent") then
        pcall(function() KickRemote:FireServer(1) fired = true end)
    end

    return fired
end

local function activateKick()
    local button = findKickButton()
    if not button then return false end

    local success = false
    for i = 1, 4 do
        if fireKickButton(button) then success = true end
        task.wait(0.06)
    end

    if success then
        task.spawn(function()
            task.wait(CFG.PerfectDelay)
            if CFG.Enabled then
                simulatePerfect()
            end
        end)
    end
    return success
end

-- ================= PERFECT CLICK (cứng) =================
local function getClickPositions()
    local cam = workspace.CurrentCamera
    if not cam then return {{400, 300}} end
    local vs = cam.ViewportSize
    local cx = math.floor(vs.X * 0.5)
    return {
        {cx, math.floor(vs.Y * 0.55)},
        {cx, math.floor(vs.Y * 0.60)},
        {cx, math.floor(vs.Y * 0.65)},
        {cx, math.floor(vs.Y * 0.50)},
        {math.floor(vs.X * 0.48), math.floor(vs.Y * 0.58)},
        {math.floor(vs.X * 0.52), math.floor(vs.Y * 0.58)},
    }
end

local function rawClick(x, y)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(CFG.PerfectClickHold)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
end

local function fireButton(btn)
    if not btn or not btn:IsA("GuiButton") then return false end
    local fired = false

    if getconnections then
        for _, sig in ipairs({"MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up"}) do
            local ok, conns = pcall(function() return getconnections(btn[sig]) end)
            if ok and conns then
                for _, c in ipairs(conns) do
                    pcall(function() c:Fire() fired = true end)
                end
            end
        end
    end

    if firesignal then
        pcall(function() firesignal(btn.Activated) fired = true end)
        pcall(function() firesignal(btn.MouseButton1Click) fired = true end)
    end

    local absPos = btn.AbsolutePosition
    local absSize = btn.AbsoluteSize
    if absSize.X > 0 and absSize.Y > 0 then
        local bx = math.floor(absPos.X + absSize.X / 2)
        local by = math.floor(absPos.Y + absSize.Y / 2)
        rawClick(bx, by)
        fired = true
    end
    return fired
end

local function findPerfectButtons()
    local keywords = {"perfect", "nhấn", "đá", "timing", "click", "tap", "space", "press", "hold", "now"}
    local found = {}
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("GuiButton") and obj.Visible and obj.AbsoluteSize.X > 5 then
            local text = ""
            pcall(function()
                text = (obj.Text or "") .. " "
                local label = obj:FindFirstChildOfClass("TextLabel")
                if label then text = text .. (label.Text or "") end
            end)
            text = string.lower(text)
            for _, kw in ipairs(keywords) do
                if string.find(text, kw) then
                    table.insert(found, obj)
                    break
                end
            end
        end
    end
    return found
end

function simulatePerfect()
    local deadline = os.clock() + CFG.PerfectWindow
    local attempts = 0
    local success = false

    while os.clock() < deadline and attempts < CFG.PerfectRetries and CFG.Enabled do
        attempts += 1
        setStatus("Perfect attempt #" .. attempts)

        local buttons = findPerfectButtons()
        for _, btn in ipairs(buttons) do
            if fireButton(btn) then success = true end
        end

        local positions = getClickPositions()
        for _, pos in ipairs(positions) do
            rawClick(pos[1], pos[2])
            task.wait(0.03)
        end

        if success then
            setStatus("Perfect đã gửi")
            return true
        end
        task.wait(0.15)
    end

    -- spam lần cuối
    local positions = getClickPositions()
    for _ = 1, 4 do
        for _, pos in ipairs(positions) do
            rawClick(pos[1], pos[2])
            task.wait(0.02)
        end
    end

    setStatus(success and "Perfect đã gửi" or "Perfect timeout")
    return success
end

-- ================= COLLECT =================
local function getHitbox(obj)
    if obj:IsA("BasePart") then return obj end
    return obj:FindFirstChild("RootPart", true)
        or obj:FindFirstChild("Hitbox", true)
        or obj:FindFirstChildWhichIsA("BasePart", true)
end

local function collectNearby(root, safePosition)
    local debris = workspace:FindFirstChild("Debris")
    if not debris or not CollectRemote then return end

    local current = root.Position
    local flatCurrent = Vector3.new(current.X, 0, current.Z)
    local flatSafe = Vector3.new(safePosition.X, 0, safePosition.Z)
    local safeVector = flatSafe - flatCurrent
    if safeVector.Magnitude < 0.01 then return end
    local safeDirection = safeVector.Unit

    for _, obj in ipairs(debris:GetChildren()) do
        if not CFG.Enabled then return end
        if not RARITIES[obj.Name] then continue end

        local hitbox = getHitbox(obj)
        if not hitbox or not hitbox:IsA("BasePart") then continue end

        local distance = (root.Position - hitbox.Position).Magnitude
        if distance > CFG.CollectRadius then continue end

        local flatObject = Vector3.new(hitbox.Position.X, 0, hitbox.Position.Z)
        local toObject = flatObject - flatCurrent
        if toObject.Magnitude < 0.01 then toObject = safeDirection end

        if safeDirection:Dot(toObject.Unit) >= -0.2 then
            if firetouchinterest then
                task.spawn(function()
                    pcall(function()
                        firetouchinterest(root, hitbox, 0)
                        task.wait(0.05)
                        firetouchinterest(root, hitbox, 1)
                    end)
                end)
            end
            pcall(function() CollectRemote:FireServer(obj.Name) end)
        end
    end
end

-- ================= WALK BACK =================
local function walkBack(root, hum, safePosition, targetCF)
    local lastPosition = root.Position
    local stuckTime = 0
    setStatus("Đang thu thập + về KickReady")

    while CFG.Enabled and hum.Health > 0 and root.Parent do
        local distance = (root.Position - safePosition).Magnitude
        if distance <= CFG.SafeRadius then
            setStatus("Đã về KickReady")
            return true
        end

        pcall(function()
            local state = hum:GetState()
            if hum.Sit or hum.PlatformStand
                or state == Enum.HumanoidStateType.Ragdoll
                or state == Enum.HumanoidStateType.FallingDown then
                hum.Sit = false
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.Running)
                hum.Jump = true
            end
        end)

        collectNearby(root, safePosition)

        pcall(function()
            if not hum.Sit and hum:GetState() ~= Enum.HumanoidStateType.Ragdoll then
                hum:MoveTo(safePosition)
            end
        end)

        if (root.Position - lastPosition).Magnitude < 0.5 then
            stuckTime += CFG.ScanDelay
        else
            stuckTime = 0
            lastPosition = root.Position
        end

        if stuckTime >= CFG.StuckTimeout then
            setStatus("Bị kẹt — TP về")
            forceTP(root, targetCF + Vector3.new(0, 3, 0))
            return false
        end
        task.wait(CFG.ScanDelay)
    end
    return false
end

-- ================= MAIN LOOP =================
task.spawn(function()
    while gui.Parent do
        if not CFG.Enabled then
            task.wait(0.2)
            continue
        end

        local ok, err = pcall(function()
            local char, root, hum = getCharacter()
            if not char then
                setStatus("Đang chờ nhân vật")
                return
            end

            local targetCF = getKickTarget()
            if not targetCF then
                setStatus("Không tìm thấy Areas.KickReady")
                return
            end

            local safePosition = targetCF.Position

            if (root.Position - safePosition).Magnitude > 10 then
                setStatus("Đang về điểm kick")
                forceTP(root, targetCF + Vector3.new(0, 3, 0))
                task.wait(0.5)
            end

            if not CFG.Enabled then return end

            local startPosition = root.Position
            local deadline = os.clock() + CFG.LaunchTimeout

            setStatus("Đang chờ cú đá")

            local kicked = false
            while CFG.Enabled and hum.Health > 0 and os.clock() < deadline do
                local button = findKickButton()
                if button and button.Visible then
                    setStatus("Tìm thấy KickButton — kích hoạt")
                    if activateKick() then
                        kicked = true
                        break
                    end
                end
                if not root.Parent then return end
                if (root.Position - startPosition).Magnitude > CFG.LaunchDistance then
                    break
                end
                task.wait(0.08)
            end

            if not kicked then
                setStatus("Không kích hoạt được KickButton")
                return
            end

            if not CFG.Enabled or hum.Health <= 0 then return end

            task.wait(CFG.PerfectDelay + 0.8)

            if (root.Position - startPosition).Magnitude <= CFG.LaunchDistance then
                setStatus("Chưa phát hiện phóng đi")
                return
            end

            walkBack(root, hum, safePosition, targetCF)
        end)

        if not ok then
            warn("[AutoKickSafeRun]", err)
            setStatus("Lỗi — xem Console")
        end

        task.wait(CFG.KickCooldown)
    end
end)

