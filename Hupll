-- language: Luau, file: AutoKickSafeRun.lua
-- Auto Kick + Safe Run + Auto Collect
-- Executor: getconnections / firesignal / VirtualInputManager / firetouchinterest
-- Target: workspace.Areas.KickReady

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

local function getNetwork()
    local shared = ReplicatedStorage:FindFirstChild("Shared")
    local packages = shared and shared:FindFirstChild("Packages")
    return packages and packages:FindFirstChild("Network")
end

local Net = getNetwork()
local KickRemote = Net and Net:FindFirstChild("rev_KickEvent")
local CollectRemote = Net and Net:FindFirstChild("rev_CollectShard")

-- ================= CONFIG =================
local CFG = {
    Enabled = false,
    KickCooldown = 1,
    LaunchDistance = 40,
    LaunchTimeout = 15,
    CollectRadius = 60,
    SafeRadius = 6,
    StuckTimeout = 3,
    ScanDelay = 0.1,

    -- Perfect
    PerfectDelay = 0.47,
    PerfectWindow = 1.6,
    PerfectClickHold = 0.04,
    PerfectRetries = 5,
}

local RARITIES = {
    Common = true, Rare = true, Epic = true, Legendary = true,
    Mythic = true, Godly = true, Secret = true, Divine = true,
    Hacked = true, OG = true, Celestial = true, Eternal = true,
}

