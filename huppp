-- ================= HELPERS =================

local function getCharacter()
    local char = player.Character
    if not char then return end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    if not root or not hum or hum.Health <= 0 then
        return
    end

    return char, root, hum
end

local function getKickTarget()
    local areas = workspace:FindFirstChild("Areas")
    local target = areas and areas:FindFirstChild("KickReady")
    if not target then return nil end

    if target:IsA("BasePart") then
        return target.CFrame
    elseif target:IsA("Model") then
        return target:GetPivot()
    end

    return nil
end

local function findKickButton()
    local hud = PlayerGui:FindFirstChild("HUD")
    local btn = hud and hud:FindFirstChild("KickButton", true)

    if btn and btn:IsA("GuiButton") then
        return btn
    end

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj.Name == "KickButton" and obj:IsA("GuiButton") then
            return obj
        end
    end

    return nil
end

local function forceTP(root, targetCF)
    if not root or not root.Parent then return false end

    local ok = pcall(function()
        root.CFrame = targetCF
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    return ok
end

-- ================= PERFECT CLICK (giữa màn hình) =================


local function simulateCenterClick()
    local camera = workspace.CurrentCamera
    if not camera then return false end

    local viewport = camera.ViewportSize

    -- Vị trí góc dưới bên phải
    local cx = math.floor(viewport.X * 0.32)
local cy = math.floor(viewport.Y * 0.78)

    -- Cách 1: VirtualInputManager
    local ok = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(
            cx, cy, 0, true, game, 1
        )

        task.wait(CFG.PerfectClickHold)

        VirtualInputManager:SendMouseButtonEvent(
            cx, cy, 0, false, game, 1
        )
    end)

    if ok then
        return true
    end

    -- Cách 2: mouse1click
    if mouse1click then
        local success = pcall(function()
            mouse1click()
        end)

        if success then
            return true
        end
    end

    -- Cách 3: Tìm nút GUI liên quan đến đá bóng
    for _, obj in ipairs(PlayerGui:GetDescendants()) do

        if obj:IsA("GuiButton") then

            local text = ""

            pcall(function()
                text = obj.Text or ""

                local label = obj:FindFirstChildOfClass("TextLabel")
                if label then
                    text = text .. " " .. label.Text
                end
            end)

            text = string.lower(text)

            if string.find(text, "nhấn")
                or string.find(text, "đá") then

                if getconnections then
                    for _, sig in ipairs({
                        "MouseButton1Click",
                        "Activated"
                    }) do

                        local signalOk, connections = pcall(function()
                            return getconnections(obj[sig])
                        end)

                        if signalOk and connections then
                            for _, connection in ipairs(connections) do
                                pcall(function()
                                    connection:Fire()
                                end)
                            end
                        end
                    end
                end

                if firesignal then
                    pcall(function()
                        firesignal(obj.Activated)
                    end)
                end

                return true
            end
        end
    end

    return false
end

-- ================= KICK =================

local function activateKick()
    local button = findKickButton()

    if not button or not button.Visible then
        return false
    end

    local activated = false

    if getconnections then
        for _, signalName in ipairs({"MouseButton1Click", "Activated"}) do
            local ok, connections = pcall(function()
                return getconnections(button[signalName])
            end)

            if ok and connections then
                for _, connection in ipairs(connections) do
                    pcall(function()
                        connection:Fire()
                        activated = true
                    end)
                end
            end
        end
    end

    if not activated and firesignal then
        local ok = pcall(function()
            firesignal(button.Activated)
        end)
        activated = ok
    end

    if not activated and KickRemote and KickRemote:IsA("RemoteEvent") then
        local ok = pcall(function()
            KickRemote:FireServer(1)
        end)
        activated = ok
    end

    -- Sau khi kick thành công → chờ PerfectDelay rồi nhấn giữa màn hình
    if activated then
        task.spawn(function()
            task.wait(CFG.PerfectDelay)
            if CFG.Enabled then
                setStatus("Đang nhấn perfect...")
                local success = simulateCenterClick()
                if success then
                    setStatus("Perfect đã gửi")
                else
                    setStatus("Không gửi được perfect click")
                end
            end
        end)
    end

    return activated
end

-- ================= COLLECT =================

local function getHitbox(obj)
    if obj:IsA("BasePart") then
        return obj
    end

    return obj:FindFirstChild("RootPart", true)
        or obj:FindFirstChild("Hitbox", true)
        or obj:FindFirstChildWhichIsA("BasePart", true)
end

local function collectNearby(root, safePosition)
    local debris = workspace:FindFirstChild("Debris")
    if not debris or not CollectRemote then return end

    local current = root.Position
    local flatCurrent = Vector3.new(current.X, 0, current.Z)
    local flatSafe = Vector3.new(safePosition.X, 0, safePosition.Z)

    local safeVector = flatSafe - flatCurrent
    if safeVector.Magnitude < 0.01 then return end

    local safeDirection = safeVector.Unit

    for _, obj in ipairs(debris:GetChildren()) do
        if not CFG.Enabled then return end

        if not RARITIES[obj.Name] then
            continue
        end

        local hitbox = getHitbox(obj)
        if not hitbox or not hitbox:IsA("BasePart") then
            continue
        end

        local distance = (root.Position - hitbox.Position).Magnitude
        if distance > CFG.CollectRadius then
            continue
        end

        local flatObject = Vector3.new(hitbox.Position.X, 0, hitbox.Position.Z)
        local toObject = flatObject - flatCurrent
        if toObject.Magnitude < 0.01 then
            toObject = safeDirection
        end

        if safeDirection:Dot(toObject.Unit) >= -0.2 then
            if firetouchinterest then
                task.spawn(function()
                    pcall(function()
                        firetouchinterest(root, hitbox, 0)
                        task.wait(0.05)
                        firetouchinterest(root, hitbox, 1)
                    end)
                end)
            end

            pcall(function()
                CollectRemote:FireServer(obj.Name)
            end)
        end
    end
end

-- ================= WALK BACK =================

local function walkBack(root, hum, safePosition, targetCF)
    local lastPosition = root.Position
    local stuckTime = 0

    setStatus("Đang thu thập và đi bộ về KickReady")

    while CFG.Enabled and hum.Health > 0 and root.Parent do
        local distance = (root.Position - safePosition).Magnitude

        if distance <= CFG.SafeRadius then
            setStatus("Đã về KickReady")
            return true
        end

        pcall(function()
            local state = hum:GetState()

            if hum.Sit
                or hum.PlatformStand
                or state == Enum.HumanoidStateType.Ragdoll
                or state == Enum.HumanoidStateType.FallingDown then
                hum.Sit = false
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.Running)
                hum.Jump = true
            end
        end)

        collectNearby(root, safePosition)

        pcall(function()
            if not hum.Sit and hum:GetState() ~= Enum.HumanoidStateType.Ragdoll then
                hum:MoveTo(safePosition)
            end
        end)

        if (root.Position - lastPosition).Magnitude < 0.5 then
            stuckTime += CFG.ScanDelay
        else
            stuckTime = 0
            lastPosition = root.Position
        end

        if stuckTime >= CFG.StuckTimeout then
            setStatus("Bị kẹt — thử quay về KickReady")
            forceTP(root, targetCF + Vector3.new(0, 3, 0))
            return false
        end

        task.wait(CFG.ScanDelay)
    end

    return false
end

-- ================= MAIN LOOP =================

task.spawn(function()
    while gui.Parent do
        if not CFG.Enabled then
            task.wait(0.2)
            continue
        end

        local ok, err = pcall(function()
            local char, root, hum = getCharacter()
            if not char then
                setStatus("Đang chờ nhân vật")
                return
            end

            local targetCF = getKickTarget()
            if not targetCF then
                setStatus("Không tìm thấy Areas.KickReady")
                return
            end

            local safePosition = targetCF.Position

            if (root.Position - safePosition).Magnitude > 10 then
                setStatus("Đang về điểm kick")
                forceTP(root, targetCF + Vector3.new(0, 3, 0))
                task.wait(0.5)
            end

            if not CFG.Enabled then return end

            local startPosition = root.Position
            local deadline = os.clock() + CFG.LaunchTimeout

            setStatus("Đang chờ cú đá")

            while CFG.Enabled and hum.Health > 0 and os.clock() < deadline do
                local button = findKickButton()

                if button and button.Visible then
                    activateKick()
                    -- chỉ fire 1 lần rồi chờ perfect + launch
                    break
                end

                if not root.Parent then return end

                if (root.Position - startPosition).Magnitude > CFG.LaunchDistance then
                    break
                end

                task.wait(0.1)
            end

            if not CFG.Enabled or hum.Health <= 0 then
                return
            end

            -- chờ thêm thời gian cho perfect + launch xảy ra
            task.wait(CFG.PerfectDelay + 0.8)

            if (root.Position - startPosition).Magnitude <= CFG.LaunchDistance then
                setStatus("Chưa phát hiện nhân vật được phóng đi")
                return
            end

            walkBack(root, hum, safePosition, targetCF)
        end)

        if not ok then
            warn("[AutoKickSafeRun]", err)
            setStatus("Lỗi — xem Console")
        end

        task.wait(CFG.KickCooldown)
    end
end)

