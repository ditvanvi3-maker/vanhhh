-- Auto Kick + Safe Run + Auto Collect (hardened click)
-- Executor: getgenv / getconnections / firesignal / VirtualInputManager
-- Target: workspace.Areas.KickReady
-- Patch: force perfect khi kẹt chờ > 2s, bắn thêm 1 lần sau khi thoát chờ, click lệch trái + retry

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

local function getNetwork()
    local shared = ReplicatedStorage:FindFirstChild("Shared")
    local packages = shared and shared:FindFirstChild("Packages")
    return packages and packages:FindFirstChild("Network")
end

local Net = getNetwork()
local KickRemote = Net and Net:FindFirstChild("rev_KickEvent")
local CollectRemote = Net and Net:FindFirstChild("rev_CollectShard")

-- ================= CONFIG =================

local CFG = {
    Enabled = false,
    KickCooldown = 1,
    LaunchDistance = 40,
    LaunchTimeout = 15,
    CollectRadius = 60,
    SafeRadius = 6,
    StuckTimeout = 3,
    ScanDelay = 0.1,

    PerfectDelay = 0.45,
    PerfectClickHold = 0.06,
    WaitKickForceTime = 2,       -- force perfect nếu kẹt chờ đá > 2s
    ClickRetry = 3,              -- số lần thử mỗi lần gọi simulate
    ClickRetryGap = 0.08,
}

local RARITIES = {
    Common = true, Rare = true, Epic = true, Legendary = true,
    Mythic = true, Godly = true, Secret = true, Divine = true,
    Hacked = true, OG = true, Celestial = true, Eternal = true,
}

