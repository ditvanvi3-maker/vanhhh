-- language: Lua, Kick a Lucky Block — Thanksgiving auto pick
-- nghe Spill → tự FireServer toàn bộ Id

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Network = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Packages"):WaitForChild("Network")

local spill = Network:WaitForChild("rev_tgSpill")
local pick  = Network:WaitForChild("rev_tgPick")

local currentRun = nil
local pending = {}          -- [Id] = Kind
local AUTO = true           -- tắt/bật nhanh

-- nhận list item mới từ server
spill.OnClientEvent:Connect(function(data)
    if typeof(data) ~= "table" or not data.RunId or not data.Items then return end

    currentRun = data.RunId
    pending = {}

    for _, item in ipairs(data.Items) do
        if item.Id and item.Kind then
            pending[item.Id] = item.Kind
            if AUTO then
                -- fire ngay lập tức
                pcall(function()
                    pick:FireServer(currentRun, item.Id)
                end)
                if true then -- debug
                    print("[AutoPick]", item.Kind, "Id =", item.Id, "Run =", currentRun)
                end
            end
        end
    end
end)

-- backup: spam lại các Id còn pending mỗi 0.4s (phòng packet trễ)
task.spawn(function()
    while true do
        task.wait(0.4)
        if AUTO and currentRun and next(pending) then
            for id, kind in pairs(pending) do
                pcall(function()
                    pick:FireServer(currentRun, id)
                end)
            end
        end
    end
end)

-- optional: clear pending khi nhận confirm harvest
local harvest = Network:FindFirstChild("rev_tgHarvest")
if harvest then
    harvest.OnClientEvent:Connect(function(data)
        if typeof(data) == "table" and data.Id then
            pending[data.Id] = nil
            print("[Harvested]", data.Kind or "?", "Id =", data.Id)
        end
    end)
end

