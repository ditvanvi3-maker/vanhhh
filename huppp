-- language: Luau, file: AutoKickSafeRun.lua
-- Auto Kick + Safe Run + Auto Collect
-- Executor cần: getgenv / getconnections / firesignal / VirtualInputManager / firetouchinterest
-- Target: workspace.Areas.KickReady

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

local function getNetwork()
    local shared = ReplicatedStorage:FindFirstChild("Shared")
    local packages = shared and shared:FindFirstChild("Packages")
    return packages and packages:FindFirstChild("Network")
end

local Net = getNetwork()
local KickRemote = Net and Net:FindFirstChild("rev_KickEvent")
local CollectRemote = Net and Net:FindFirstChild("rev_CollectShard")

-- ================= CONFIG =================
local CFG = {
    Enabled = false,
    KickCooldown = 1,
    LaunchDistance = 40,
    LaunchTimeout = 15,
    CollectRadius = 60,
    SafeRadius = 6,
    StuckTimeout = 3,
    ScanDelay = 0.1,

    -- Perfect timing (ổn định)
    PerfectDelay = 0.25,      -- base delay trước khi bắt đầu poll
    PerfectWindow = 1.2,      -- thời gian tối đa tìm + click perfect
    PerfectClickHold = 0.05,
    PerfectRetries = 3,
}

local RARITIES = {
    Common = true,
    Rare = true,
    Epic = true,
    Legendary = true,
    Mythic = true,
    Godly = true,
    Secret = true,
    Divine = true,
    Hacked = true,
    OG = true,
    Celestial = true,
    Eternal = true,
}

